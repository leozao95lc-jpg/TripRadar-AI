ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://tripradar:tripradar@localhost:5432/tripradar
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-production
SESSION_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8000/api/v1/auth/oauth/google/callback

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@tripradar.ai
SMTP_USE_TLS=false

WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0

FLIGHT_PROVIDER=mock
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
# Ver docs/11-provider-integration-strategy.md — valores default são um ponto de
# partida de sandbox, não o contrato real. Ajustar AMADEUS_MAX_REQUESTS_PER_MINUTE
# para o limite de fato contratado antes do primeiro deploy em produção.
AMADEUS_CONNECT_TIMEOUT_SECONDS=3.0
AMADEUS_READ_TIMEOUT_SECONDS=8.0
AMADEUS_MAX_RETRIES=3
AMADEUS_MAX_REQUESTS_PER_MINUTE=60
AMADEUS_CACHE_TTL_SECONDS=1800
PROVIDER_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60.0

# Rotas populares que o worker monitora quando ainda não há alerta ativo nenhum
# (ver workers/price_polling_worker.py) — não é uma variável de ambiente hoje,
# fica hardcoded no worker; PRICE_POLLING_BATCH_SIZE e
# PRICE_DROP_ALERT_THRESHOLD_PCT abaixo sim são configuráveis.
PRICE_POLLING_BATCH_SIZE=50
PRICE_DROP_ALERT_THRESHOLD_PCT=5.0

CORS_ALLOW_ORIGINS=["http://localhost:3000"]
