# Copie para .env e preencha. O .env nunca deve ser versionado.

# --- Acesso (obrigatório) ---
APP_PASSWORD=troque-por-uma-senha-forte
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_HOURS=168
# Origem(ns) do frontend autorizadas a chamar a API, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
# URL da API vista pelo navegador (usada no build do frontend)
PUBLIC_API_URL=http://localhost:8000
# true quando servir por HTTPS
COOKIE_SECURE=false

# --- IA editorial (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high

# --- Transcrição local (Faster-Whisper) ---
# tiny | base | small | medium | large-v3  (maior = melhor e mais lento)
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# int8 (CPU) | float16 (GPU)
WHISPER_COMPUTE_TYPE=int8

# --- Upload e armazenamento ---
MAX_UPLOAD_MB=8192
MIN_FREE_DISK_MB=2048

# --- Render ---
RENDER_CRF=18
RENDER_PRESET=medium

# --- Fila ---
JOB_MAX_ATTEMPTS=2
